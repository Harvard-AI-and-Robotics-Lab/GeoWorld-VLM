# Copy this file to configs/paths.local.env and edit the paths for your machine.

export GEMMA_MODEL="${GEMMA_MODEL:-/path/to/gemma-4-E4B-it}"
export LINGBOT_MODEL="${LINGBOT_MODEL:-/path/to/lingbot-world-fast-or-base-cam}"
export LINGBOT_CODE="${LINGBOT_CODE:-/path/to/lingbot-world}"

export ADAPTVIS_DATA_DIR="${ADAPTVIS_DATA_DIR:-/path/to/data}"
export ADAPTVIS_PROMPTS_DIR="${ADAPTVIS_PROMPTS_DIR:-/path/to/prompts}"
export EMBSPATIAL_JSON="${EMBSPATIAL_JSON:-/path/to/embspatial.json}"
export SAT_ROOT="${SAT_ROOT:-/path/to/sat_DATA}"

export OUTPUT_DIR="${OUTPUT_DIR:-outputs}"
export RESULTS_DIR="${RESULTS_DIR:-results}"

